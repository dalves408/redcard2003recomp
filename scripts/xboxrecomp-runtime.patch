@@ -0,0 +1,256 @@
+/* nv2a_vsh_gen.inc -- PROJECT code, #included at the end of nv2a_vsh_interp.c
+ * (it needs the static decoder). Turns the active NV2A vertex program into the
+ * body of an HLSL vertex shader (see nv2a_pbx.h, Nv2aGpuVs). The semantics are
+ * those of vsh_exec above; keep them in step. */
+#include <stdarg.h>
+#include "nv2a_gpu_vs.h"
+
+typedef struct { char *p; size_t n, cap; int ovf; } GenBuf;
+
+static void gen_pf(GenBuf *b, const char *fmt, ...)
+{
+    va_list ap;
+    int r;
+
+    if (b->ovf)
+        return;
+    va_start(ap, fmt);
+    r = vsnprintf(b->p + b->n, b->cap - b->n, fmt, ap);
+    va_end(ap);
+    if (r < 0 || (size_t)r >= b->cap - b->n) {
+        b->ovf = 1;
+        return;
+    }
+    b->n += (size_t)r;
+}
+
+static const char *gen_mask(uint32_t m, char out[8])
+{
+    int k = 0;
+
+    if (m & 8) out[k++] = 'x';
+    if (m & 4) out[k++] = 'y';
+    if (m & 2) out[k++] = 'z';
+    if (m & 1) out[k++] = 'w';
+    out[k] = 0;
+    return out;
+}
+
+static void gen_src(GenBuf *b, const DecSrc *d)
+{
+    static const char sw[] = "xyzw";
+
+    gen_pf(b, "%s", d->neg ? "-" : "");
+    if (d->mux == DEC_TEMP)
+        gen_pf(b, "R[%u]", (unsigned)d->idx);
+    else if (d->mux == DEC_INPUT)
+        gen_pf(b, "V[%u]", (unsigned)d->idx);
+    else if (d->rel)
+        gen_pf(b, "KR(%u, a0)", (unsigned)d->c);
+    else
+        gen_pf(b, "K(%u)", (unsigned)(d->c < NV2A_VSH_CONSTANTS ? d->c : 0));
+    if (!(d->sw[0] == 0 && d->sw[1] == 1 && d->sw[2] == 2 && d->sw[3] == 3))
+        gen_pf(b, ".%c%c%c%c", sw[d->sw[0]], sw[d->sw[1]], sw[d->sw[2]], sw[d->sw[3]]);
+}
+
+int nv2a_vsh_export(Nv2aGpuVs *e)
+{
+    static Nv2aGpuVs cached;
+    static uint32_t revision, start, cxt;
+    static int valid;
+    uint32_t i,k,h=2166136261u;
+    if (valid && revision==s_program_revision && start==s_start_slot && cxt==s_cxt_write) {
+        memcpy(e->prog,cached.prog,cached.nslots*sizeof e->prog[0]);
+        e->nslots=cached.nslots;e->hash=cached.hash;e->input_mask=cached.input_mask;
+        e->fixed_function=0;return 1;
+    }
+    if (!s_dec_valid || s_dec_rev!=s_program_revision) dec_program();
+    e->input_mask=0;e->fixed_function=0;
+    for(i=0;i<s_dec_count;i++) {
+        const DecIns *d=&s_dec[i];
+        if(s_cxt_write && d->omask && !d->to_o) return 0;
+        memcpy(e->prog[i],s_program[s_start_slot+i],sizeof e->prog[0]);
+        for(k=0;k<3;k++) if((d->reads&(1u<<k)) && d->src[k].mux==DEC_INPUT)
+            e->input_mask|=1u<<d->src[k].idx;
+        for(k=0;k<4;k++) h=(h^e->prog[i][k])*16777619u;
+        if(d->final) {
+            e->nslots=i+1;e->hash=h;cached=*e;revision=s_program_revision;
+            start=s_start_slot;cxt=s_cxt_write;valid=1;return 1;
+        }
+    }
+    return 0;
+}
+
+int nv2a_vsh_export_ffp(Nv2aGpuVs *e, uint32_t input_mask, uint32_t variant)
+{
+    memset(e, 0, sizeof *e);
+    e->fixed_function = 1;
+    e->nslots = 0;
+    e->input_mask = input_mask;
+    /* Distinct hash per attr/lighting variant so the D3D11 specialisation
+     * cache does not reuse an unlit body for a lit batch. */
+    e->hash = 0xFF700000u ^ input_mask ^ (variant * 0x9E3779B9u);
+    return 1;
+}
+
+static void gen_decode(const uint32_t *ins, DecIns *d)
+{
+    uint32_t t=field(ins,3,20,4);int k;
+    memset(d,0,sizeof *d);
+    d->mac=(uint8_t)field(ins,1,21,4);d->ilu=(uint8_t)field(ins,1,25,3);
+    d->mac_mask=(uint8_t)field(ins,3,24,4);d->ilu_mask=(uint8_t)field(ins,3,16,4);
+    d->mac_dst=(uint8_t)t;d->ilu_dst=(uint8_t)(d->mac?1:t);
+    d->omask=(uint8_t)field(ins,3,12,4);d->oaddr=(uint8_t)field(ins,3,3,8);
+    d->to_o=(uint8_t)field(ins,3,11,1);d->from_ilu=(uint8_t)field(ins,3,2,1);
+    d->final=(uint8_t)field(ins,3,0,1);d->reads=dec_reads(d->mac,d->ilu);
+    for(k=0;k<3;k++)dec_src(ins,k,&d->src[k]);
+}
+
+/* Fixed-function GPU-VS body (after V[] fetch). Constants packed by gvs_try:
+ *   K0..K3  composite 4x4 rows (same as CPU ffp_vertex)
+ *   K4.xyz  viewport offset (c[59]); wrapper applies aa
+ *   K5.x    asuint cfg: bit0=lighting, bit1=flip_normals,
+ *           bits8..11=color attr, bits12..15=tex0 attr,
+ *           bits16..17=colmat ambient mode, bits18..19=colmat diffuse mode
+ *   K5.yzw  scene ambient rgb
+ *   K5 unused w reused: material alpha lives in K(42).x
+ *   K6..K9  modelview 4x4
+ *   light i at K(10+i*4)..K(13+i*4): amb.xyz+kind, dif.xyz+range,
+ *     Ldir_or_pos.xyz+atten0, atten1/atten2
+ *   K42.x   material alpha
+ * Outputs match program path: R[12]=screen (pre-aa), O[3]=rgba, O[9]=tex0. */
+static void gen_ffp_body(GenBuf *b)
+{
+    /* CPU ffp_vertex: clip[i] = dot(row_i, pos). HLSL mul(M,v) with M built
+     * from row vectors matches that; mul(v,M) is the transpose and was the
+     * mid-match 3D wipeout (verify: cpu screen ~469 vs gpu ~0.53). */
+    gen_pf(b,
+        "  float4x4 M = float4x4(K(0), K(1), K(2), K(3));\n"
+        "  float4 clip = mul(M, V[0]);\n"
+        "  float w = clip.w;\n"
+        /* CPU ffp_vertex drops |w|<=1e-6. Forcing w=1 exploded shadow volumes
+         * into the pitch lattice. NaN culls the triangle on D3D11. */
+        "  if (abs(w) <= 1e-6) R[12] = asfloat(0x7fc00000u).xxxx;\n"
+        "  else R[12] = float4(clip.x / w + K(4).x, clip.y / w + K(4).y, clip.z / w + K(4).z, w);\n"
+        "  uint cfg = asuint(K(5).x);\n"
+        "  uint ca = (cfg >> 8) & 15u; uint ta = (cfg >> 12) & 15u;\n"
+        "  float4 vcol = V[ca];\n"
+        "  float3 rgb = vcol.xyz; float a = vcol.w;\n"
+        "  if (cfg & 1u) {\n"
+        "    float4x4 MV = float4x4(K(6), K(7), K(8), K(9));\n"
+        "    float3 eye = mul(MV, V[0]).xyz;\n"
+        "    float3 n = mul(MV, float4(V[2].xyz, 0.0)).xyz;\n"
+        "    float nl = length(n); if (nl > 1e-8) n *= rcp(nl);\n"
+        "    if ((cfg & 2u) && dot(n, eye) > 0.0) n = -n;\n"
+        "    float3 sum = K(5).yzw;\n"
+        "    uint cma = (cfg >> 16) & 3u; uint cmd = (cfg >> 18) & 3u;\n"
+        "    [unroll] for (uint li = 0u; li < 8u; li++) {\n"
+        "      float4 L0 = K(10u + li * 4u), L1 = K(11u + li * 4u);\n"
+        "      float4 L2 = K(12u + li * 4u), L3 = K(13u + li * 4u);\n"
+        "      uint kind = (uint)L0.w; if (!kind) continue;\n"
+        "      float3 L; float att = 1.0;\n"
+        "      if (kind == 1u) L = L2.xyz;\n"
+        "      else {\n"
+        "        float3 dlt = L2.xyz - eye; float dist = length(dlt);\n"
+        "        if (L1.w > 0.0 && dist > L1.w) continue;\n"
+        "        L = dlt * rcp(max(dist, 1e-8));\n"
+        "        att = rcp(max(L2.w + L3.x * dist + L3.y * dist * dist, 1e-8));\n"
+        "      }\n"
+        "      float ndl = max(0.0, dot(n, L));\n"
+        "      float3 amb = L0.xyz, dif = L1.xyz;\n"
+        "      if (cma == 1u) amb *= vcol.xyz;\n"
+        "      if (cmd == 1u) dif *= vcol.xyz;\n"
+        "      sum += (amb + dif * ndl) * att;\n"
+        "    }\n"
+        "    rgb = saturate(sum);\n"
+        "    a = (cmd == 1u) ? vcol.w : K(42).x;\n"
+        "  }\n"
+        "  O[3] = float4(saturate(rgb), saturate(a));\n"
+        "  O[4] = float4(0.0, 0.0, 0.0, 0.0);\n" /* wrapper presets O[4].w=1; CPU FFP leaves d1 zero */
+        "  O[9] = V[ta]; O[10] = V[10]; O[11] = V[11]; O[12] = V[12];\n"
+        "  O[5] = float4(1.0, 0.0, 0.0, 1.0);\n");
+}
+
+/* Emits the statements from "float4 V[16]" to the last output write. The
+ * wrapper provides: vi (the vertex index), gbase, K(i), KR(i, a0), fetch(i, vi). */
+int nv2a_vsh_gen_hlsl(const Nv2aGpuVs *e, char *out, size_t cap)
+{
+    GenBuf gb, *b = &gb;
+    uint32_t s, i;
+    char m1[8], m2[8];
+
+    gb.p = out; gb.n = 0; gb.cap = cap; gb.ovf = 0;
+    if (!cap)
+        return 0;
+    out[0] = 0;
+    gen_pf(b, "  float4 V[16]; float4 R[13]; float4 O[13]; int a0 = 0;\n");
+    gen_pf(b, "  [unroll] for (int ii = 0; ii < 16; ii++) V[ii] = float4(0.0, 0.0, 0.0, 1.0);\n");
+    gen_pf(b, "  [unroll] for (int ij = 0; ij < 13; ij++) { R[ij] = float4(0.0, 0.0, 0.0, 0.0);"
+              " O[ij] = float4(0.0, 0.0, 0.0, 0.0); }\n");
+    gen_pf(b, "  O[3].w = 1.0; O[4].w = 1.0; O[9].w = 1.0; O[10].w = 1.0; O[11].w = 1.0; O[12].w = 1.0;\n");
+    for (i = 0; i < 16; i++)
+        if ((e->input_mask >> i) & 1)
+            gen_pf(b, "  V[%u] = fetch(%uu, vi);\n", i, i);
+    if (e->fixed_function) {
+        gen_ffp_body(b);
+        return b->ovf ? 0 : 1;
+    }
+    for (s = 0; s < e->nslots; s++) {
+        DecIns d;
+        gen_decode(e->prog[s], &d);
+        gen_pf(b, "  { // slot %u\n", s);
+        gen_pf(b, "    float4 m = float4(0.0, 0.0, 0.0, 0.0); float4 il = m;\n");
+        if (d.reads & 1) { gen_pf(b, "    float4 a = "); gen_src(b, &d.src[0]); gen_pf(b, ";\n"); }
+        if (d.reads & 2) { gen_pf(b, "    float4 bb = "); gen_src(b, &d.src[1]); gen_pf(b, ";\n"); }
+        if (d.reads & 4) { gen_pf(b, "    float4 c = "); gen_src(b, &d.src[2]); gen_pf(b, ";\n"); }
+        switch (d.mac) {
+        case 0:  break;
+        case 1:  gen_pf(b, "    m = a;\n"); break;
+        case 2:  gen_pf(b, "    m = a * bb;\n"); break;
+        case 3:  gen_pf(b, "    m = a + c;\n"); break;
+        case 4:  gen_pf(b, "    m = a * bb + c;\n"); break;
+        case 5:  gen_pf(b, "    m = m_dp3(a, bb);\n"); break;
+        case 6:  gen_pf(b, "    m = m_dph(a, bb);\n"); break;
+        case 7:  gen_pf(b, "    m = m_dp4(a, bb);\n"); break;
+        case 8:  gen_pf(b, "    m = float4(1.0, a.y * bb.y, a.z, bb.w);\n"); break;
+        case 9:  gen_pf(b, "    m = m_min(a, bb);\n"); break;
+        case 10: gen_pf(b, "    m = m_max(a, bb);\n"); break;
+        case 11: gen_pf(b, "    m = m_slt(a, bb);\n"); break;
+        case 12: gen_pf(b, "    m = m_sge(a, bb);\n"); break;
+        case 13: gen_pf(b, "    a0 = (int)floor(a.x + 0.001); m = a;\n"); break;
+        default: gen_pf(b, "    m = a;\n"); break;
+        }
+        switch (d.ilu) {
+        case 0:  break;
+        case 2:  gen_pf(b, "    il = i_rcp(c.x);\n"); break;
+        case 3:  gen_pf(b, "    il = i_rcc(c.x);\n"); break;
+        case 4:  gen_pf(b, "    il = i_rsq(c.x);\n"); break;
+        case 5:  gen_pf(b, "    il = i_exp(c.x);\n"); break;
+        case 6:  gen_pf(b, "    il = i_log(c.x);\n"); break;
+        case 7:  gen_pf(b, "    il = i_lit(c);\n"); break;
+        default: gen_pf(b, "    il = c;\n"); break;
+        }
+        if (d.mac && d.mac != 13 && d.mac_mask && d.mac_dst <= 12)
+            gen_pf(b, "    R[%u].%s = m.%s;\n", (unsigned)d.mac_dst,
+                   gen_mask(d.mac_mask, m1), gen_mask(d.mac_mask, m2));
+        if (d.ilu && d.ilu_mask) {
+            uint32_t it = d.mac ? 1u : d.mac_dst;
+            if (it <= 12)
+                gen_pf(b, "    R[%u].%s = il.%s;\n", (unsigned)it,
+                       gen_mask(d.ilu_mask, m1), gen_mask(d.ilu_mask, m2));
+        }
+        if (d.omask && d.to_o) {
+            const char *src = d.from_ilu ? "il" : "m";
+            if (d.oaddr == 0)
+                gen_pf(b, "    R[12].%s = %s.%s;\n", gen_mask(d.omask, m1), src, gen_mask(d.omask, m2));
+            else if (d.oaddr < 13)
+                gen_pf(b, "    O[%u].%s = %s.%s;\n", (unsigned)d.oaddr, gen_mask(d.omask, m1),
+                       src, gen_mask(d.omask, m2));
+        }
+        gen_pf(b, "  }\n");
+        if (d.final)
+            break;
+    }
+    return b->ovf ? 0 : 1;
+}
