+/* Adapted from the NHL Hitz 2003 recompilation GPU vertex interface. */
+#ifndef REDCARD_NV2A_GPU_VS_H
+#define REDCARD_NV2A_GPU_VS_H
+#include <stdint.h>
+#include <stddef.h>
+#define NV2A_VSH_SLOTS_MAX 136
+#define GVS_OFF_CONST 0u
+#define GVS_OFF_ATTR  3072u
+#define GVS_OFF_IMM   3328u
+#define GVS_OFF_IDX   3584u
+
+typedef struct {
+    uint32_t prog[NV2A_VSH_SLOTS_MAX][4];   /* microcode, start slot .. FINAL */
+    uint32_t nslots, hash, input_mask;
+    uint32_t fixed_function;                /* project FFP shader, constants packed by executor */
+    const uint8_t *block;                   /* valid inside draw() only */
+    uint32_t block_bytes;
+    uint32_t nidx;                          /* indices = vertices drawn */
+    float    aa_sx, aa_sy;
+    uint32_t fog_mode;                      /* 0: fog off, else the NV097 fog mode word */
+    float    fog_px, fog_py;
+    uint32_t verify;                        /* RECOMP_GPUVS_VERIFY: read the outputs back */
+    float   *verify_out;                    /* min(nidx, 4096) x 29 floats, or NULL */
+    uint32_t *verify_count;                 /* points actually read back; 0 if draw/readback was skipped */
+} Nv2aGpuVs;
+
+int nv2a_vsh_export(Nv2aGpuVs *e);
+/* Fixed-function GPU path: no microcode; constants packed by the executor. */
+int nv2a_vsh_export_ffp(Nv2aGpuVs *e, uint32_t input_mask, uint32_t variant);
+int nv2a_vsh_gen_hlsl(const Nv2aGpuVs *e, char *out, size_t cap);
+
+#endif
diff --git a/src/kernel/nv2a_gvs_exec.inc b/src/kernel/nv2a_gvs_exec.inc
new file mode 100644
index 0000000..234b3b7
--- /dev/null
+++ b/src/kernel/nv2a_gvs_exec.inc
@@ -0,0 +1,299 @@
+/* GPU vertex-program handoff adapted from the Hitz port's raw-span packer.
+ * Unsupported programs/arrays retain the CPU path. No guest pointer survives draw. */
+#define GVS_BLOCK_MAX (6u<<20)
+typedef struct { uint64_t lo,hi;uint32_t attr; } GvsSeg;
+static Nv2aGpuVs s_gvs;
+static uint8_t *s_gvs_blk;
+static float s_gvs_vout[4096*29];
+static unsigned long s_gvs_draws,s_gvs_checked,s_gvs_bad;
+enum { GF_ATTR,GF_SPARSE,GF_BIG,GF_OFF,GF_NOPROG,GF_NORC,GF_NBACKEND,GF_SMALL,
+       GF_ZORIGIN,GF_PRIM,GF_NIDX,GF_EXPORT,GF_PROBE,GF_NOMEM,GF_NREASON };
+static unsigned long s_gvs_skip[GF_NREASON];
+static int gvs_stats_on(void)
+{
+    static int v=-1;
+    if(v<0){const char *e=getenv("RECOMP_GVS_STATS");v=e&&e[0]&&e[0]!='0';}
+    return v;
+}
+static void gvs_stats_maybe(void)
+{
+    static unsigned long last;
+    unsigned long total=s_gvs_checked;
+    if(!gvs_stats_on() || total<500 || total-last<2000)return;
+    last=total;
+    fprintf(stderr,
+        "[GVS] checked=%lu ok=%lu bad=%lu skip off=%lu noprog=%lu norc=%lu "
+        "nbackend=%lu small=%lu zorigin=%lu prim=%lu nidx=%lu export=%lu "
+        "probe=%lu nomem=%lu attr=%lu sparse=%lu big=%lu\n",
+        s_gvs_checked,s_gvs_draws,s_gvs_bad,
+        s_gvs_skip[GF_OFF],s_gvs_skip[GF_NOPROG],s_gvs_skip[GF_NORC],
+        s_gvs_skip[GF_NBACKEND],s_gvs_skip[GF_SMALL],s_gvs_skip[GF_ZORIGIN],
+        s_gvs_skip[GF_PRIM],s_gvs_skip[GF_NIDX],s_gvs_skip[GF_EXPORT],
+        s_gvs_skip[GF_PROBE],s_gvs_skip[GF_NOMEM],s_gvs_skip[GF_ATTR],
+        s_gvs_skip[GF_SPARSE],s_gvs_skip[GF_BIG]);
+    fflush(stderr);
+}
+static int gvs_fail(int reason,uint32_t n)
+{
+    if((unsigned)reason<(unsigned)GF_NREASON)s_gvs_skip[reason]++;
+    (void)n;gvs_stats_maybe();return 0;
+}
+/* Pack FFP constants into the GPU-VS constant block (see gen_ffp_body). */
+static void gvs_pack_ffp_constants(float *dst, uint32_t ca_idx, uint32_t ta_idx)
+{
+    const float *off = nv2a_vsh_constant(59);
+    const float *mv = (const float *)&s_reg[0x0480 / 4];
+    uint32_t cfg, mask = s_reg[0x03BC / 4], colmat = s_reg[0x0298 / 4];
+    int lit = s_reg[0x0314 / 4] && s_gpu.attr[2].size;
+    int i;
+
+    memset(dst, 0, NV2A_VSH_CONSTANTS * 16u);
+    memcpy(dst, s_gpu.composite, 64);
+    dst[16] = off[0]; dst[17] = off[1]; dst[18] = off[2];
+    cfg = (lit ? 1u : 0u)
+        | (ffp_flip_normals() ? 2u : 0u)
+        | ((ca_idx & 15u) << 8)
+        | ((ta_idx & 15u) << 12)
+        | (((colmat >> 2) & 3u) << 16)
+        | (((colmat >> 4) & 3u) << 18);
+    memcpy(&dst[20], &cfg, 4);
+    dst[21] = reg_f(0x0A10); dst[22] = reg_f(0x0A14); dst[23] = reg_f(0x0A18);
+    if (lit) {
+        memcpy(dst + 24, mv, 64);
+        for (i = 0; i < NV_LIGHTS; i++) {
+            uint32_t kind = (mask >> (2 * i)) & 3u, b = 0x1000 + (uint32_t)i * 0x80;
+            float *L = dst + 40 + i * 16; /* K(10+i*4) */
+            if (!kind) continue;
+            L[0] = reg_f(b + 0x00); L[1] = reg_f(b + 0x04); L[2] = reg_f(b + 0x08);
+            L[3] = (float)kind;
+            L[4] = reg_f(b + 0x0C); L[5] = reg_f(b + 0x10); L[6] = reg_f(b + 0x14);
+            L[7] = reg_f(b + 0x24); /* range */
+            if (kind == 1u) {
+                L[8] = reg_f(b + 0x34); L[9] = reg_f(b + 0x38); L[10] = reg_f(b + 0x3C);
+            } else {
+                L[8] = reg_f(b + 0x5C); L[9] = reg_f(b + 0x60); L[10] = reg_f(b + 0x64);
+            }
+            L[11] = reg_f(b + 0x68);
+            L[12] = reg_f(b + 0x6C); L[13] = reg_f(b + 0x70);
+        }
+        dst[168] = reg_f(0x03B4); /* K(42).x material alpha */
+    }
+}
+
+static int gvs_try(void)
+{
+    uint32_t n=s_gpu.idx_count,nidx=0,i,a,minidx=0xffffffffu,maxidx=0;
+    uint32_t nseg=0,nm=0,attr_seg[16],segpos[16],ni,pos,*desc,*ib,vcount=0;
+    GvsSeg seg[16],mseg[16];uint64_t copied=0;float *imm;const uint8_t *mem;
+    static int enabled=-1,verify=-1;
+    int is_ffp=0; uint32_t ca_idx=3, ta_idx=9, ffp_variant=0;
+    s_gvs_checked++;
+    if(enabled<0){const char *v=getenv("RECOMP_D3D11_GPUVS");enabled=v&&atoi(v)!=0;}
+    if(!enabled)return gvs_fail(GF_OFF,n);
+    {
+        static int ffp_gvs = -1;
+        if (ffp_gvs < 0) {
+            const char *e = getenv("RECOMP_GVS_FFP");
+            /* Default off: mul(M,v) fixes the wipeout, but some FFP meshes
+             * (shadow-like lattice) still glitch vs CPU. Opt in with =1. */
+            ffp_gvs = e && e[0] && e[0] != '0';
+        }
+        is_ffp = ffp_gvs && batch_is_ffp();
+    }
+    if(!batch_uses_program() && !is_ffp)return gvs_fail(GF_NOPROG,n);
+    if(!s_gpu.rc_seen)return gvs_fail(GF_NORC,n);
+    if(!s_backend || !s_backend->gpu_probe)return gvs_fail(GF_NBACKEND,n);
+    if(n<3)return gvs_fail(GF_SMALL,n);
+    /* CPU clipping adjusts a nonzero viewport depth origin; defer this case. */
+    if(nv2a_vsh_constant(59)[2]!=0.0f)return gvs_fail(GF_ZORIGIN,n);
+    switch(s_gpu.prim) {
+    case NV_PRIM_TRIANGLES:nidx=n-n%3;break;
+    case NV_PRIM_TRIANGLE_STRIP:case NV_PRIM_TRIANGLE_FAN:case NV_PRIM_POLYGON:nidx=3*(n-2);break;
+    case NV_PRIM_QUADS:nidx=6*(n/4);break;
+    case NV_PRIM_QUAD_STRIP:nidx=6*((n-2)/2);break;
+    default:return gvs_fail(GF_PRIM,n);
+    }
+    if(!nidx || nidx>(GVS_BLOCK_MAX-GVS_OFF_IDX)/4)return gvs_fail(GF_NIDX,n);
+    memset(&s_gvs,0,sizeof s_gvs);
+    if(is_ffp) {
+        uint32_t mask = 1u; /* position */
+        const VertexAttr *ca = color_attr(), *ta = texcoord_attr();
+        ca_idx = (uint32_t)(ca - s_gpu.attr);
+        ta_idx = (uint32_t)(ta - s_gpu.attr);
+        if (ca_idx >= NV2A_VSH_INPUTS) ca_idx = 3;
+        if (ta_idx >= NV2A_VSH_INPUTS) ta_idx = 9;
+        mask |= 1u << ca_idx;
+        mask |= 1u << ta_idx;
+        if (s_reg[0x0314 / 4] && s_gpu.attr[2].size)
+            mask |= 1u << 2;
+        for (i = 1; i < 4; i++)
+            if (s_gpu.attr[9 + i].size)
+                mask |= 1u << (9 + i);
+        ffp_variant = mask
+            | ((s_reg[0x0314 / 4] && s_gpu.attr[2].size) ? 0x10000u : 0)
+            | (ffp_flip_normals() ? 0x20000u : 0)
+            | ((s_reg[0x0298 / 4] & 0x3Cu) << 14);
+        if (!nv2a_vsh_export_ffp(&s_gvs, mask, ffp_variant))
+            return gvs_fail(GF_EXPORT, n);
+    } else if (!nv2a_vsh_export(&s_gvs)) {
+        return gvs_fail(GF_EXPORT, n);
+    }
+    if(verify<0){const char *v=getenv("RECOMP_GPUVS_VERIFY");verify=v&&atoi(v)!=0;}
+    s_gvs.verify=verify && (s_gvs_draws<60 || s_gvs_draws%250==0);
+    s_gvs.verify_out=s_gvs_vout;s_gvs.verify_count=&vcount;
+    if(!s_backend->gpu_probe(&s_gvs))return gvs_fail(GF_PROBE,n);
+    if(!s_gvs_blk && !(s_gvs_blk=malloc(GVS_BLOCK_MAX)))return gvs_fail(GF_NOMEM,n);
+    for (i = 0; i < n; i++) {
+        if (s_gpu.idx[i] < minidx) minidx = s_gpu.idx[i];
+        if (s_gpu.idx[i] > maxidx) maxidx = s_gpu.idx[i];
+    }
+    mem = (const uint8_t *)xbox_GetMemoryOffset();
+    imm = (float *)(s_gvs_blk + GVS_OFF_IMM);
+    desc = (uint32_t *)(s_gvs_blk + GVS_OFF_ATTR);
+    memset(desc, 0, 16 * 16);
+    for (a = 0; a < NV2A_VSH_INPUTS; a++) {
+        imm[a * 4 + 0] = imm[a * 4 + 1] = imm[a * 4 + 2] = 0.0f;
+        imm[a * 4 + 3] = 1.0f;
+        desc[a * 4 + 3] = 1;                     /* constant unless a fetch below says otherwise */
+        attr_seg[a] = 0xFFFFFFFFu;
+    }
+    for (a = 0; a < NV2A_VSH_INPUTS; a++) {
+        const VertexAttr *at = &s_gpu.attr[a];
+        uint32_t elem;
+        uint64_t lo, hi;
+
+        if (!((s_gvs.input_mask >> a) & 1u))
+            continue;
+        if (!at->size && a < NV_VERTEX_ATTRS) {
+            memcpy(&imm[a * 4], s_gpu.imm_attr[a], 16);
+            continue;
+        }
+        if (!at->size || !at->stride)
+            continue;
+        if (!(at->type <= 2 || at->type == 4 || at->type == 5 || at->type == 6))
+            continue;                            /* fetch_attr: unsupported type reads as absent */
+        elem = attr_elem_bytes(at);
+        lo = (uint64_t)at->offset + (uint64_t)minidx * at->stride;
+        hi = (uint64_t)at->offset + (uint64_t)maxidx * at->stride + elem;
+        if (s_gpu.inline_active) {
+            if (hi > (uint64_t)s_gpu.inline_count * 4)
+                return gvs_fail(GF_ATTR, n);
+        } else {
+            if (!at->offset || !guest_span_ok(lo, elem) || !guest_span_ok(hi - elem, elem))
+                return gvs_fail(GF_ATTR, n);
+        }
+        seg[nseg].lo = lo; seg[nseg].hi = hi; seg[nseg].attr = a; nseg++;
+    }
+    /* sort by lo, merge near ones */
+    for (i = 1; i < nseg; i++) {
+        uint32_t j = i;
+        GvsSeg t = seg[i];
+        while (j && seg[j - 1].lo > t.lo) { seg[j] = seg[j - 1]; j--; }
+        seg[j] = t;
+    }
+    for (i = 0; i < nseg; i++) {
+        if (nm && seg[i].lo <= mseg[nm - 1].hi + 64) {
+            if (seg[i].hi > mseg[nm - 1].hi) mseg[nm - 1].hi = seg[i].hi;
+        } else {
+            mseg[nm].lo = seg[i].lo; mseg[nm].hi = seg[i].hi; nm++;
+        }
+        attr_seg[seg[i].attr] = nm - 1;
+    }
+    for (i = 0; i < nm; i++)
+        copied += mseg[i].hi - mseg[i].lo;
+    if (copied > 32768u + 16u * (uint64_t)n)
+        return gvs_fail(GF_SPARSE, n);
+
+    ni = (nidx * 4u + 15u) & ~15u;
+    pos = GVS_OFF_IDX + ni;
+    for (i = 0; i < nm; i++) {
+        uint64_t len = mseg[i].hi - mseg[i].lo;
+        uint32_t p = (pos + 15u) & ~15u;
+        p += (uint32_t)(mseg[i].lo & 15u);
+        if ((uint64_t)p + len > GVS_BLOCK_MAX)
+            return gvs_fail(GF_BIG, n);
+        memcpy(s_gvs_blk + p, (s_gpu.inline_active ? (const uint8_t *)s_gpu.inline_buf : mem) + mseg[i].lo, (size_t)len);
+        segpos[i] = p;
+        pos = p + (uint32_t)len;
+    }
+    for (a = 0; a < NV2A_VSH_INPUTS; a++) {
+        const VertexAttr *at = &s_gpu.attr[a];
+        uint32_t m = attr_seg[a];
+        if (m == 0xFFFFFFFFu)
+            continue;
+        desc[a * 4 + 0] = (uint32_t)((uint64_t)segpos[m] + (uint64_t)at->offset - mseg[m].lo);
+        desc[a * 4 + 1] = at->stride;
+        desc[a * 4 + 2] = at->type | (at->size < 4 ? at->size : 4u) << 8;
+        desc[a * 4 + 3] = 0;
+    }
+    if (is_ffp)
+        gvs_pack_ffp_constants((float *)(s_gvs_blk + GVS_OFF_CONST), ca_idx, ta_idx);
+    else
+        memcpy(s_gvs_blk + GVS_OFF_CONST, nv2a_vsh_constant(0), NV2A_VSH_CONSTANTS * 16u);
+
+    /* triangle-list index array, in the CPU path's assembly order */
+    ib = (uint32_t *)(s_gvs_blk + GVS_OFF_IDX);
+    {
+        uint32_t o = 0;
+        switch (s_gpu.prim) {
+        case NV_PRIM_TRIANGLES:
+            for (i = 0; i + 2 < n; i += 3) { ib[o++] = s_gpu.idx[i]; ib[o++] = s_gpu.idx[i+1]; ib[o++] = s_gpu.idx[i+2]; }
+            break;
+        case NV_PRIM_TRIANGLE_STRIP:
+            for (i = 0; i + 2 < n; i++) { uint32_t alt=(i&1) && strip_alt_winding();ib[o++]=s_gpu.idx[i+alt];ib[o++]=s_gpu.idx[i+1-alt];ib[o++]=s_gpu.idx[i+2]; }
+            break;
+        case NV_PRIM_TRIANGLE_FAN:
+        case NV_PRIM_POLYGON:
+            for (i = 1; i + 1 < n; i++) { ib[o++] = s_gpu.idx[0]; ib[o++] = s_gpu.idx[i]; ib[o++] = s_gpu.idx[i+1]; }
+            break;
+        case NV_PRIM_QUADS:
+            for (i = 0; i + 3 < n; i += 4) {
+                ib[o++] = s_gpu.idx[i]; ib[o++] = s_gpu.idx[i+1]; ib[o++] = s_gpu.idx[i+2];
+                ib[o++] = s_gpu.idx[i]; ib[o++] = s_gpu.idx[i+2]; ib[o++] = s_gpu.idx[i+3];
+            }
+            break;
+        case NV_PRIM_QUAD_STRIP:
+            for (i = 0; i + 3 < n; i += 2) {
+                ib[o++] = s_gpu.idx[i]; ib[o++] = s_gpu.idx[i+1]; ib[o++] = s_gpu.idx[i+3];
+                ib[o++] = s_gpu.idx[i]; ib[o++] = s_gpu.idx[i+3]; ib[o++] = s_gpu.idx[i+2];
+            }
+            break;
+        default: break;
+        }
+    }
+    s_gvs.block = s_gvs_blk;
+    s_gvs.block_bytes = pos;
+
+    s_gvs.nidx = nidx;
+    s_gvs.aa_sx = s_gpu.aa_sx;
+    s_gvs.aa_sy = s_gpu.aa_sy;
+    s_gvs.fog_mode = s_gpu.fog_enable ? (s_gpu.fog_mode ? s_gpu.fog_mode : 1u) : 0u;
+    s_gvs.fog_px = s_gpu.fog_param[0];
+    s_gvs.fog_py = s_gpu.fog_param[1];
+
+
+    s_gpu.batches_program++;s_gpu.verts_program+=n;
+    s_active_gpu=&s_gvs;s_bcount=nidx;backend_flush(1);s_active_gpu=NULL;
+    s_gvs_draws++;
+    if(s_gvs.verify && vcount) {
+        uint32_t k,c,bad=0;
+        s_gvs_checked++;
+        for(k=0;k<vcount;k++) {
+            Nv2aVshOutput out;float want[29];
+            if(!transform_vertex(ib[k],&out))continue;
+            memcpy(want,out.pos,16);memcpy(want+4,out.d0,16);memcpy(want+8,out.d1,16);
+            memcpy(want+12,out.tex,64);want[28]=fog_factor(out.fog[0]);
+            for(c=0;c<29;c++) {
+                float w=want[c],g=s_gvs_vout[k*29+c];
+                if((isnan(w)&&isnan(g)) || (isinf(w)&&w==g))continue;
+                if(!(fabs((double)w-g)<=1e-3*fmax(1.0,fabs((double)w))+2e-3)) {
+                    if(s_gvs_bad<12 && bad<3)fprintf(stderr,"[GPUVS-VERIFY] hash=%08X vertex=%u component=%u cpu=%g gpu=%g\n",s_gvs.hash,k,c,w,g);
+                    bad++;
+                }
+            }
+        }
+        if(bad)s_gvs_bad++;
+        fprintf(stderr,"[GPUVS-VERIFY] compared=%lu mismatching_draws=%lu latest_components=%u\n",s_gvs_checked,s_gvs_bad,bad);
+    } else if(s_gvs.verify)fprintf(stderr,"[GPUVS-VERIFY] MISSING readback hash=%08X\n",s_gvs.hash);
+    return 1;
+}
diff --git a/src/kernel/nv2a_pb_exec.c b/src/kernel/nv2a_pb_exec.c
