+ * announcer "terrible", ball-hit "screech" — while a quieter bed still looked
+ * fine on a WAV peak meter between hits. */
+static float mcpx_apu_soft_clip(float x)
+{
+    const float knee = 0.85f;
+    float ax = fabsf(x);
+    float y;
+    if (ax <= knee)
+        return x;
+    y = knee + (1.0f - knee) * tanhf((ax - knee) / (1.0f - knee));
+    if (y > 1.0f) y = 1.0f;
+    return copysignf(y, x);
