+/* OHCI descriptors and payload buffers are physical DMA addresses. A low
+ * physical address can numerically overlap an executable XBE section; those
+ * bytes belong to the contiguous-window alias, not to the image's code. */
+static uint32_t bus_resolve_dma(uint32_t addr)
+{
+    /* Like Hitz's ownership-based DMA routing: report buffers allocated in
+     * ordinary guest RAM remain there when later texture allocations make
+     * the contiguous arena's high-water mark grow past the same number. */
+    if (xbox_PhysRamNamedAt(addr))
+        return addr;
+    if (xbox_PhysImageNamedAt(addr))
+        return addr;
+    if (xbox_PhysContiguousNamedAt(addr))
+        return OHCI_CONTIG_BASE + addr;
+    if (addr >= g_xbox_code_lo && addr < g_xbox_code_hi
+            && addr < xbox_ContiguousAllocatedBytes()
+            && addr < OHCI_CONTIG_SIZE)
+        return OHCI_CONTIG_BASE + addr;
+    return bus_resolve(addr);
+}
+
+/* The first resolution of a DMA page sticks.
+ *
+ * bus_resolve's fallback reads "below the contiguous allocator's high-water
+ * mark" as "in the window". That mark grows during play (RedCard allocates
+ * mid-match), so a report buffer XAPI set up in ordinary RAM flipped to the
+ * window a few seconds into a match: reports were written where XAPI never
+ * looked, and the game kept the last state it saw -- a player running one way
+ * for ever and no button answering. USB descriptors and report buffers are
+ * allocated once and kept, so whatever a page resolved to when the driver
+ * first used it is where it still is. */
+static uint32_t bus_resolve_dma_sticky(uint32_t addr)
+{
+    enum { NSTICK = 512 };
+    static uint32_t page[NSTICK], base[NSTICK];
+    static unsigned n, flips;
+    uint32_t pg = addr >> 12, r, i;
+
+    for (i = 0; i < n; i++)
+        if (page[i] == pg) {
+            r = bus_resolve_dma(addr);
+            if ((r >> 12) != base[i] && flips < 8) {
+                flips++;
+                fprintf(stderr, "  [OHCI] DMA page %08X now resolves to %08X; "
+                        "keeping %08X (first use)\n", pg << 12, r & ~0xFFFu, base[i] << 12);
+                fflush(stderr);
+            }
+            return (base[i] << 12) | (addr & 0xFFFu);
+        }
+    r = bus_resolve_dma(addr);
+    if (n < NSTICK) { page[n] = pg; base[n] = r >> 12; n++; }
+    return r;
+}
