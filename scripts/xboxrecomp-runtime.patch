+/* ADPCM blocks vouch for the memory they were read from.
+ *
+ * A sample page below 64 MB can name a heap (RAM) page or a contiguous
+ * window page with the same number; vp_phys picks one the first time a
+ * voice touches it. Picked wrong, an effect plays whatever the other copy
+ * holds -- crackle and noise on the short one-shot effects (ball, whistle,
+ * tackles) while long streams sound right. Every 36-byte block opens with a
+ * header per channel: a sample, a step index that must be 0..88, and a
+ * byte that encoders leave 0. When the copy in use fails that and the other
+ * copy passes it, the voice switches pages and stays switched. */
+static unsigned s_adpcm_flips, s_adpcm_flip_reverts;
+
+static int adpcm_headers_ok(const uint32_t *blk, unsigned int channels)
+{
+    const uint8_t *b = (const uint8_t *)blk;
+    for (unsigned int ch = 0; ch < channels; ch++)
+        if (b[4 * ch + 2] > 88 || b[4 * ch + 3] != 0)
+            return 0;
+    return 1;
+}
+
+static int adpcm_try_other_copy(uint32_t v, hwaddr a0, hwaddr a1)
+{
+    static unsigned bad;
+    if (++bad <= 30 || (bad & (bad - 1)) == 0)
+        fprintf(stderr, "[APU] voice %u: ADPCM header invalid at %08X (%s)"
+                " [%u bad headers so far]\n", v, (uint32_t)a0,
+                mcpx_apu_phys_class(a0), bad);
+    int n = vp_page_flip(v, a0);
+    if (((uint32_t)a1 >> VP_PAGE_SHIFT) != ((uint32_t)a0 >> VP_PAGE_SHIFT))
+        n |= vp_page_flip(v, a1);
+    return n;
+}
+
+static void adpcm_check_flip(uint32_t v, hwaddr a0, hwaddr a1,
+                             const uint32_t *blk, unsigned int channels,
+                             unsigned int block_index)
+{
+    if (adpcm_headers_ok(blk, channels)) {
+        s_adpcm_flips++;
+        if (s_adpcm_flips <= 20 || (s_adpcm_flips & (s_adpcm_flips - 1)) == 0)
+            fprintf(stderr, "[APU] voice %u block %u at %08X: header invalid in"
+                    " the copy in use, valid in the other; page switched"
+                    " (%u so far)\n", v, block_index, (uint32_t)a0, s_adpcm_flips);
+        return;
+    }
+    /* Neither copy looks like ADPCM here (or the title pads its blocks):
+     * put the choice back and play what was there, as before. */
+    adpcm_try_other_copy(v, a0, a1);
+    s_adpcm_flip_reverts++;
+}
